    "run1 = wandb.init(project=\"mcq-solver\", name=\"model1-bilstm-scratch\", reinit=True)\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "\n",
    "model1 = ScratchBiLSTM(vocab_size=len(vocab)).to(device)\n",
    "optimizer = torch.optim.Adam(model1.parameters(), lr=1e-3)\n",
    "criterion = nn.CrossEntropyLoss()\n",
    "\n",
    "train_loader = DataLoader(MCQDataset(tr_df, vocab), batch_size=32, shuffle=True)\n",
    "val_ds_m1 = MCQDataset(val_df, vocab)\n",
    "val_loader = DataLoader(val_ds_m1, batch_size=32)\n",
    "\n",
    "for epoch in range(8):\n",
    "    model1.train()\n",
    "    total_loss = 0\n",
    "    for batch in train_loader:\n",
    "        prompt, options, labels = batch[\"prompt\"].to(device), batch[\"options\"].to(device), batch[\"label\"].to(device)\n",
    "        optimizer.zero_grad()\n",
    "        loss = criterion(model1(prompt, options), labels)\n",
    "        loss.backward(); optimizer.step()\n",
    "        total_loss += loss.item()\n",
    "\n",
    "    model1.eval(); correct = 0\n",
    "    with torch.no_grad():\n",
    "        for batch in val_loader:\n",
    "            prompt, options, labels = batch[\"prompt\"].to(device), batch[\"options\"].to(device), batch[\"label\"].to(device)\n",
    "            correct += (model1(prompt, options).argmax(-1) == labels).sum().item()\n",
    "    val_acc = correct / len(val_ds_m1)\n",
    "    print(f\"Epoch {epoch+1}: loss={total_loss/len(train_loader):.4f}, val_acc={val_acc:.4f}\")\n",
    "    wandb.log({\"epoch\": epoch+1, \"train_loss\": total_loss/len(train_loader), \"val_accuracy\": val_acc})"
   ]
