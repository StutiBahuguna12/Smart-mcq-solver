    "from collections import Counter\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "\n",
    "def build_vocab(texts, min_freq=2, max_vocab=20000):\n",
    "    counter = Counter()\n",
    "    for t in texts:\n",
    "        counter.update(t.split())\n",
    "    vocab = {\"<PAD>\": 0, \"<UNK>\": 1}\n",
    "    for word, freq in counter.most_common(max_vocab):\n",
    "        if freq >= min_freq:\n",
    "            vocab[word] = len(vocab)\n",
    "    return vocab\n",
    "\n",
    "all_text = pd.concat([tr_df[f\"{PROMPT_COL}_clean\"]] + [tr_df[f\"{o}_clean\"] for o in OPTION_COLS])\n",
    "vocab = build_vocab(all_text)\n",
    "print(\"Vocab size:\", len(vocab))\n",
    "\n",
    "MAX_LEN = 40\n",
    "def encode_text(text, vocab, max_len=MAX_LEN):\n",
    "    tokens = text.split()[:max_len]\n",
    "    ids = [vocab.get(tok, vocab[\"<UNK>\"]) for tok in tokens]\n",
    "    ids += [vocab[\"<PAD>\"]] * (max_len - len(ids))\n",
    "    return ids\n",
    "\n",
    "class MCQDataset(Dataset):\n",
    "    def __init__(self, df, vocab, has_label=True):\n",
    "        self.df = df.reset_index(drop=True)\n",
    "        self.vocab = vocab\n",
    "        self.has_label = has_label\n",
    "    def __len__(self): return len(self.df)\n",
    "    def __getitem__(self, idx):\n",
    "        row = self.df.iloc[idx]\n",
    "        prompt_ids = torch.tensor(encode_text(row[f\"{PROMPT_COL}_clean\"], self.vocab))\n",
    "        option_ids = torch.stack([torch.tensor(encode_text(row[f\"{o}_clean\"], self.vocab)) for o in OPTION_COLS])\n",
    "        item = {\"prompt\": prompt_ids, \"options\": option_ids}\n",
    "        if self.has_label:\n",
    "            item[\"label\"] = torch.tensor(row[\"answer_encoded\"])\n",
    "        return item\n",
    "\n",
    "class ScratchBiLSTM(nn.Module):\n",
    "    def __init__(self, vocab_size, embed_dim=128, hidden_dim=128):\n",
    "        super().__init__()\n",
    "        self.embedding = nn.Embedding(vocab_size, embed_dim, padding_idx=0)\n",
    "        self.lstm = nn.LSTM(embed_dim, hidden_dim, batch_first=True, bidirectional=True)\n",
    "        self.proj = nn.Linear(hidden_dim*2, hidden_dim)\n",
    "    def encode(self, x):\n",
    "        emb = self.embedding(x)\n",
    "        out, (h, c) = self.lstm(emb)\n",
    "        h_cat = torch.cat([h[0], h[1]], dim=-1)\n",
    "        return self.proj(h_cat)\n",
    "    def forward(self, prompt, options):\n",
    "        p_vec = self.encode(prompt)\n",
    "        batch, n_opts, seq_len = options.shape\n",
    "        o_vec = self.encode(options.view(batch*n_opts, seq_len)).view(batch, n_opts, -1)\n",
    "        return torch.bmm(o_vec, p_vec.unsqueeze(-1)).squeeze(-1)"
