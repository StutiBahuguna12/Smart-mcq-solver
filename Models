    "from transformers import AutoTokenizer, AutoModelForMultipleChoice, TrainingArguments, Trainer, default_data_collator\n",
    "from peft import LoraConfig, get_peft_model, TaskType\n",
    "from datasets import Dataset\n",
    "\n",
    "def preprocess_factory(tokenizer, max_length=128):\n",
    "    def preprocess(examples):\n",
    "        first = [[str(p)] * 5 for p in examples[f\"{PROMPT_COL}_clean\"]]\n",
    "        second = [[str(examples[f\"{opt}_clean\"][i]) for opt in OPTION_COLS] for i in range(len(examples[f\"{PROMPT_COL}_clean\"]))]\n",
    "        first, second = sum(first, []), sum(second, [])\n",
    "        tok = tokenizer(first, second, truncation=True, padding=\"max_length\", max_length=max_length)\n",
    "        return {k: [v[i:i+5] for i in range(0, len(v), 5)] for k, v in tok.items()}\n",
    "    return preprocess\n",
    "\n",
    "def build_lora_mc_model(model_name):\n",
    "    tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
    "    base = AutoModelForMultipleChoice.from_pretrained(model_name)\n",
    "    lora_config = LoraConfig(\n",
    "        task_type=TaskType.SEQ_CLS, r=8, lora_alpha=16, lora_dropout=0.1,\n",
    "        bias=\"none\", target_modules=[\"query\", \"value\"],\n",
    "    )\n",
    "    model = get_peft_model(base, lora_config)\n",
    "    model.print_trainable_parameters()\n",
    "    return tokenizer, model\n",
    "\n",
    "def make_hf_datasets(tokenizer, max_length=128):\n",
    "    prep = preprocess_factory(tokenizer, max_length)\n",
    "    tr_ds = Dataset.from_pandas(tr_df.reset_index(drop=True)).map(prep, batched=True)\n",
    "    val_ds = Dataset.from_pandas(val_df.reset_index(drop=True)).map(prep, batched=True)\n",
    "    tr_ds = tr_ds.add_column(\"label\", tr_df[\"answer_encoded\"].tolist())\n",
    "    val_ds = val_ds.add_column(\"label\", val_df[\"answer_encoded\"].tolist())\n",
    "    return tr_ds, val_ds\n",
    "\n",
    "def train_lora_model(model_name, run_name, epochs=4, lr=3e-4):\n",
    "    run = wandb.init(project=\"mcq-solver\", name=run_name, reinit=True)\n",
    "    tokenizer, model = build_lora_mc_model(model_name)\n",
    "    tr_ds, val_ds = make_hf_datasets(tokenizer)\n",
    "    args = TrainingArguments(\n",
    "        output_dir=f\"./{run_name}_out\", per_device_train_batch_size=8, per_device_eval_batch_size=8,\n",
    "        num_train_epochs=epochs, learning_rate=lr, eval_strategy=\"epoch\", save_strategy=\"no\",\n",
    "        report_to=\"wandb\", run_name=run_name, fp16=True,\n",
    "    )\n",
    "    trainer = Trainer(model=model, args=args, train_dataset=tr_ds, eval_dataset=val_ds, data_collator=default_data_collator)\n",
    "    trainer.train()\n",
    "    preds = trainer.predict(val_ds)\n",
    "    logits = preds.predictions\n",
    "    ranked = [[OPTION_COLS[i] for i in np.argsort(-row)] for row in logits]\n",
    "    map3 = map_at_3(val_df[ANSWER_COL].tolist(), ranked)\n",
    "    print(f\"{run_name} MAP@3:\", map3)\n",
    "    wandb.log({\"final_map@3\": map3}); run.finish()\n",
    "    return trainer, tokenizer, logits, map3"
   ]
