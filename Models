    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "from sentence_transformers import SentenceTransformer, util\n",
    "\n",
    "mini_model = SentenceTransformer(\"sentence-transformers/all-MiniLM-L6-v2\")\n",
    "\n",
    "labels = [\"A\", \"B\", \"C\", \"D\", \"E\"]\n",
    "\n",
    "tfidf_hits = []\n",
    "mini_hits = []\n",
    "map_scores = []\n",
    "\n",
    "for row in train:\n",
    "\n",
    "    prompt = row[\"prompt\"]\n",
    "\n",
    "    options = [\n",
    "        row[\"A\"],\n",
    "        row[\"B\"],\n",
    "        row[\"C\"],\n",
    "        row[\"D\"],\n",
    "        row[\"E\"]\n",
    "    ]\n",
    "\n",
    "    answer = row[\"answer\"]\n",
    "\n",
    "    # ---------- TF-IDF ----------\n",
    "\n",
    "    tfidf = TfidfVectorizer()\n",
    "\n",
    "    tfidf_matrix = tfidf.fit_transform([prompt] + options)\n",
    "\n",
    "    sims = cosine_similarity(\n",
    "        tfidf_matrix[0:1],\n",
    "        tfidf_matrix[1:]\n",
    "    )[0]\n",
    "\n",
    "    tfidf_rank = np.argsort(-sims)\n",
    "\n",
    "    tfidf_top3 = [labels[i] for i in tfidf_rank[:3]]\n",
    "\n",
    "    tfidf_hits.append(answer in tfidf_top3)\n",
    "\n",
    "    # ---------- MiniLM ----------\n",
    "\n",
    "    prompt_emb = mini_model.encode(\n",
    "        prompt,\n",
    "        convert_to_tensor=True\n",
    "    )\n",
    "\n",
    "    option_embs = mini_model.encode(\n",
    "        options,\n",
    "        convert_to_tensor=True\n",
    "    )\n",
    "\n",
    "    sims = util.cos_sim(\n",
    "        prompt_emb,\n",
    "        option_embs\n",
    "    )[0]\n",
    "\n",
    "    sims = sims.cpu().numpy()\n",
    "\n",
    "    mini_rank = np.argsort(-sims)\n",
    "\n",
    "    mini_top3 = [labels[i] for i in mini_rank[:3]]\n",
    "\n",
    "    mini_hits.append(answer in mini_top3)\n",
    "\n",
    "    if answer == mini_top3[0]:\n",
    "        map_scores.append(1)\n",
    "\n",
    "    elif answer == mini_top3[1]:\n",
    "        map_scores.append(1/2)\n",
    "\n",
    "    elif answer == mini_top3[2]:\n",
    "        map_scores.append(1/3)\n",
    "\n",
    "    else:\n",
    "        map_scores.append(0)\n",
    "\n",
    "map3 = np.mean(map_scores)\n",
    "\n",
    "improved = sum(\n",
    "    (not tf) and mn\n",
    "    for tf, mn in zip(tfidf_hits, mini_hits)\n",
    ")\n",
    "\n",
    "print(\"MiniLM MAP@3 =\", round(map3,4))\n",
    "print(\"Improved Count =\", improved)"
   ]
