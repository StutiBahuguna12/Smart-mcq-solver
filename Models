    "from sentence_transformers import SentenceTransformer, util\n",
    "\n",
    "run2 = wandb.init(project=\"mcq-solver\", name=\"model2-sbert-zeroshot-pretrained\", reinit=True)\n",
    "sbert = SentenceTransformer(\"all-MiniLM-L6-v2\")\n",
    "\n",
    "def sbert_rank(df):\n",
    "    prompts = sbert.encode(df[f\"{PROMPT_COL}_clean\"].tolist(), convert_to_tensor=True, show_progress_bar=True)\n",
    "    sims = {}\n",
    "    for opt in OPTION_COLS:\n",
    "        opt_emb = sbert.encode(df[f\"{opt}_clean\"].tolist(), convert_to_tensor=True, show_progress_bar=True)\n",
    "        sims[opt] = util.cos_sim(prompts, opt_emb).diagonal().cpu().numpy()\n",
    "    sim_df = pd.DataFrame(sims)\n",
    "    ranked = sim_df.apply(lambda row: row.sort_values(ascending=False).index.tolist(), axis=1)\n",
    "    return ranked, sim_df\n",
    "\n",
    "val_ranked_m2, val_simdf_m2 = sbert_rank(val_df.reset_index(drop=True))\n",
    "map3_model2 = map_at_3(val_df[ANSWER_COL].tolist(), val_ranked_m2.tolist())\n",
    "print(\"Model 2 (SBERT zero-shot) MAP@3:\", map3_model2)\n",
    "wandb.log({\"final_map@3\": map3_model2}); run2.finish()"
   ]
