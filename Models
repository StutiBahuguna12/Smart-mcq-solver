    "probs_bert = F.softmax(torch.tensor(val_logits_bert), dim=-1).numpy()\n",
    "probs_roberta = F.softmax(torch.tensor(val_logits_roberta), dim=-1).numpy()\n",
    "\n",
    "def try_weight(w_bert):\n",
    "    combined = w_bert * probs_bert + (1 - w_bert) * probs_roberta\n",
    "    ranked = [[OPTION_COLS[i] for i in np.argsort(-row)] for row in combined]\n",
    "    return map_at_3(val_df[ANSWER_COL].tolist(), ranked)\n",
    "\n",
    "# quick sweep to pick the best weight instead of guessing 0.7/0.3 blindly\n",
    "best_w, best_map3 = 0.5, 0\n",
    "for w in np.arange(0.0, 1.01, 0.1):\n",
    "    m = try_weight(w)\n",
    "    print(f\"w_bert={w:.1f} -> MAP@3={m:.4f}\")\n",
    "    if m > best_map3:\n",
